# =============================================================================
# MatSafe — variables d'environnement (MODÈLE — ne mettez jamais de vraie clé ici)
# Copiez ce fichier en `.env` et renseignez vos valeurs. `.env` est git-ignoré.
# =============================================================================

# --- Front (navigateur) : clés PUBLIQUES uniquement -------------------------
# Tableau de bord Supabase > Project Settings > API
SUPABASE_URL=https://VOTRE_REF.supabase.co
SUPABASE_ANON_KEY=VOTRE_CLE_PUBLISHABLE_ANON

# Base d'appel des Edge Functions (souvent : https://VOTRE_REF.functions.supabase.co)
FUNCTIONS_BASE=https://VOTRE_REF.functions.supabase.co

# --- Edge Functions (SERVEUR uniquement) ------------------------------------
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sont injectées
# automatiquement par Supabase dans l'environnement des fonctions.
# La seule à définir vous-même (secret) :
#   supabase secrets set ACTIVATION_PEPPER="<longue chaîne aléatoire secrète>"
ACTIVATION_PEPPER=CHANGEZ_MOI_CHAINE_ALEATOIRE_LONGUE

# ⚠️ NE JAMAIS mettre SUPABASE_SERVICE_ROLE_KEY dans le navigateur / le dépôt / un .html livré.
